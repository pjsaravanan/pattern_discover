# Copy to .env and fill in. .env is git-ignored; real environment variables take precedence.

# Existing VPS PostgreSQL. Source tables public.price_data and public.candles are read-only;
# project writes go to the nifty_trajectory_v1 schema only.
VPS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional. When set, API data endpoints require it in the X-API-Key header. Not used by the command line.
NIFTY_API_KEY=

# Port for `nifty serve` when --port is not given.
PORT=8080

# Optional daily sync inside `nifty serve` (set both, or neither). SYNC_AT is IST.
SYNC_AT=
SYNC_CONFIG=
