# Copy to .env and fill in. .env is git-ignored; real environment variables take precedence.

# Existing VPS PostgreSQL (source public.price_data is read-only; project writes go to nifty_trajectory_v1 only).
VPS_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required by every API data endpoint (X-API-Key header). Not needed for the command line.
NIFTY_API_KEY=

# Port for `nifty serve` when --port is not given.
PORT=8080
